print(os.path.exists('/usr/local/bin/chromedriver'))  # Should return True

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

def download_excel_from_gcs(bucket_name, file_name):
    """Download an Excel file from Google Cloud Storage and return a DataFrame."""
    logging.info(f"Downloading Excel file '{file_name}' from bucket '{bucket_name}'.")
    client = storage.Client()
    bucket = client.bucket(bucket_name)
    blob = bucket.blob(file_name)
    data = blob.download_as_bytes()
    logging.info(f"Successfully downloaded '{file_name}'.")
    return pd.read_excel(BytesIO(data))

def initialize_driver():
    """Initialize the WebDriver in headless mode."""
    logging.info("Initializing WebDriver.")
    
    # Set ChromeOptions with port specification
    options = Options()
    #options = webdriver.ChromeOptions()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.binary_location = "/usr/bin/google-chrome"  # Update with Docker container's Chrome binary path
    #options.binary_location = "C:\Program Files(x86)\Google\Chrome\Application\chrome.exe"
    options.add_argument("--remote-debugging-port=9515")  # Specify the port here

    #service = Service(ChromeDriverManager().install())
    service = Service('/usr/local/bin/chromedriver')
    driver = webdriver.Chrome(service=service, options=options)
    
    logging.info("WebDriver initialized successfully.")
    return driver




def perform_search_with_js(driver, query):
    """Perform a search using JavaScript to interact with the search box."""
    logging.info(f"Performing search with query: {query}")
    driver.get("https://www.openstreetmap.org/")
    search_box = driver.find_element(By.ID, "query")
    driver.execute_script("arguments[0].value = arguments[1];", search_box, query)
    search_box.submit()
    WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.CLASS_NAME, "search_results_entry")))
    logging.info("Search executed successfully.")

def output_li_elements_text(driver):
    """Extract text content from specific <li> elements."""
    li_url_list = []
    try:
        WebDriverWait(driver, 10).until(EC.presence_of_element_located((By.CLASS_NAME, "search_results_entry")))
        li_elements = driver.find_elements(By.CSS_SELECTOR, "li.list-group-item.list-group-item-action.search_results_entry")
        for li_element in li_elements:
            a_element = li_element.find_element(By.TAG_NAME, "a")
            data_prefix = a_element.get_attribute("data-prefix")
            if data_prefix == "Residential Area":
                li_url_list.append(a_element.get_attribute("href"))
        logging.info(f"Extracted {len(li_url_list)} URLs for residential areas.")
    except Exception as e:
        logging.error(f"An error occurred while extracting elements: {str(e)}")
    return li_url_list

def main(request):
    """Main function to handle Cloud Function requests."""
    bucket_name = 'puton_bucket_001'
    excel_file_name = 'public estate list.xlsx'
    
    logging.info("Starting processing.")
    
    # Download Excel file from GCS
    public_estate_list_df = download_excel_from_gcs(bucket_name, excel_file_name)
    search_results = []

    driver = initialize_driver()
    try:
        for index, row in public_estate_list_df.iterrows():
            search_term = row['name']
            geo_list = []
            logging.info(f"Processing search term: {search_term}")
            try:
                perform_search_with_js(driver, search_term)
                li_url_list = output_li_elements_text(driver)

                for url in li_url_list:
                    driver.get(url)
                    latitude = driver.find_element(By.CLASS_NAME, "latitude").text
                    longitude = driver.find_element(By.CLASS_NAME, "longitude").text
                    geo_list.append(f"{latitude},{longitude}")
                    driver.back()

                search_results.append({"Search Term": search_term, "Geo List": geo_list})

            except Exception as e:
                logging.error(f"An error occurred during processing for {search_term}: {str(e)}")

    finally:
        driver.quit()
        logging.info("WebDriver closed.")

    # Create a DataFrame and save to CSV
    df = pd.DataFrame(search_results)
    output_file_path = 'public_estate_geo.csv'
    df.to_csv(output_file_path, index=False)
    logging.info(f"Data saved to {output_file_path}.")

    # Upload the CSV file to Google Cloud Storage
    client = storage.Client()
    bucket = client.bucket(bucket_name)
    blob = bucket.blob('public_estate_geo.csv')
    blob.upload_from_filename(output_file_path)
    logging.info("CSV uploaded successfully.")

    return "Processing completed and data uploaded."
